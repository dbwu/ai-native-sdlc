DATABASE_URL=postgresql://knowledge:local-dev-only@127.0.0.1:5432/knowledge
TEST_DATABASE_URL=postgresql://knowledge:local-dev-only@127.0.0.1:5432/knowledge

# 模型设计服务默认关闭；程序不会自动读取本文件，需在服务进程环境中配置。
# openai_compatible 使用服务根地址下的 /chat/completions，不自动选择模型。
KNOWLEDGE_MODEL_PROVIDER=disabled
KNOWLEDGE_MODEL_BASE_URL=
KNOWLEDGE_MODEL_MODEL=
KNOWLEDGE_MODEL_API_KEY=
KNOWLEDGE_MODEL_REQUIRE_KEY=true
KNOWLEDGE_MODEL_RESPONSE_FORMAT=json_object
# 单次网络操作超时，允许 1 至 300 秒。临时失败会在同一任务内重试一次。
KNOWLEDGE_MODEL_TIMEOUT_SECONDS=60
KNOWLEDGE_MODEL_MAX_OUTPUT_TOKENS=8192
# 旧兼容服务可显式选择 max_tokens，程序始终使用配置的参数名。
KNOWLEDGE_MODEL_TOKEN_PARAMETER=max_completion_tokens

# 默认由 API 进程运行后台设计任务；使用独立 worker 时改为 disabled。
KNOWLEDGE_DESIGN_WORKER=enabled

# 工程执行默认关闭；docker 模式必须事先准备镜像与可用的 Docker 服务。
# 系统不会自动拉取镜像、安装依赖或回退到宿主机执行。
KNOWLEDGE_EXECUTOR=disabled
KNOWLEDGE_EXECUTOR_IMAGE=
KNOWLEDGE_EXECUTOR_C_IMAGE=
KNOWLEDGE_EXECUTOR_CPP_IMAGE=
KNOWLEDGE_EXECUTOR_JAVA_IMAGE=
KNOWLEDGE_EXECUTOR_TIMEOUT_SECONDS=30
