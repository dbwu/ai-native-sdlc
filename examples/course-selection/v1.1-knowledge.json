{
  "entities": [
    {
      "key": "DOMAIN-COURSE",
      "kind": "Domain",
      "name": "选课业务领域",
      "description": "教学用选课系统设计，使用预置学生身份，只处理单学期；账号、支付和退课不在本轮范围。",
      "status": "draft",
      "attributes": {
        "glossary": {
          "学生": "本教程预置的学生身份",
          "课程": "教学内容定义",
          "教学班": "本学期可选择的具体开课实例",
          "选课记录": "某学生与某教学班的唯一关联"
        }
      }
    },
    {
      "key": "REQ-ENROLL",
      "kind": "Requirement",
      "name": "基础选课与已选列表",
      "description": "学生可以查询教学班目录、选择教学班并查看自己的已选列表；同一选课请求重复提交保持幂等。教学用选课系统设计，使用预置学生身份，只处理单学期；账号、支付和退课不在本轮范围。",
      "status": "draft",
      "attributes": {
        "requirement_type": "functional",
        "acceptance_criteria": [
          "学生能查看当前学期教学班目录及课程名称、授课教师。",
          "学生首次选择一个存在的教学班后，生成一条选课记录并出现在自己的已选列表。",
          "同一学生重复选择同一教学班时返回原记录，不新增记录，不产生重复的业务写入。",
          "不同学生的已选列表相互隔离。"
        ]
      }
    },
    {
      "key": "BR-UNIQUE",
      "kind": "BusinessRule",
      "name": "同一学生同一教学班的选课保持唯一与幂等",
      "description": "同一学生对同一教学班只能保留一条选课记录；重复请求返回已有结果。这是待实现的业务规则定义，表达式仅用于知识描述。",
      "status": "draft",
      "attributes": {
        "expression": {
          "unique_fields": [
            "student_id",
            "offering_id"
          ],
          "duplicate_request": "return_existing_enrollment",
          "new_record_on_duplicate": false
        }
      }
    },
    {
      "key": "COMP-ENROLL",
      "kind": "ArchitectureComponent",
      "name": "选课服务",
      "description": "待实现的选课服务设计，新增教学班容量校验和事务内并发限额控制；当前没有业务执行结果。",
      "status": "draft",
      "attributes": {
        "responsibility": "提供基础选课与已选列表，并在同一事务内处理容量校验、唯一幂等写入与人数更新，防止并发超额。",
        "extensions": {
          "implementation_status": "planned",
          "transaction_plan": [
            "开始数据库事务并锁定目标教学班记录或采用等效原子条件",
            "查询当前学生的已有选课记录，存在则返回原记录",
            "校验容量为非负整数，并检查 enrolled_count < capacity；容量为零或已满则拒绝新增",
            "以学生与教学班联合唯一约束创建选课记录，并在事务内更新人数",
            "任一步骤失败回滚；全部成功后提交事务并返回结果"
          ]
        }
      }
    },
    {
      "key": "IF-ENROLL",
      "kind": "Interface",
      "name": "选课 HTTP 接口设计",
      "description": "待实现的 HTTP 接口契约草案，在基础选课接口上补充容量信息、满员拒绝和幂等处理规则。",
      "status": "draft",
      "attributes": {
        "protocol": "http",
        "extensions": {
          "implementation_status": "planned",
          "endpoints": [
            {
              "method": "GET",
              "path": "/offerings",
              "purpose": "查询当前学期的教学班目录",
              "response": {
                "status": 200,
                "fields": [
                  "offering_id",
                  "course_name",
                  "teacher",
                  "capacity",
                  "enrolled_count"
                ]
              }
            },
            {
              "method": "POST",
              "path": "/offerings/{id}/enroll",
              "purpose": "在事务内校验容量后为当前学生新增选课；已有记录优先按幂等规则返回",
              "request_context": {
                "student_id": "预置的当前学生标识"
              },
              "responses": [
                {
                  "status": 201,
                  "meaning": "首次选课成功"
                },
                {
                  "status": 200,
                  "meaning": "重复请求返回已有选课记录，不新增记录"
                },
                {
                  "status": 409,
                  "code": "CAPACITY_FULL",
                  "meaning": "容量为零或已满，未创建新选课记录"
                },
                {
                  "status": 422,
                  "code": "INVALID_CAPACITY",
                  "meaning": "容量不符合非负整数约束，设计要求拒绝无效数据"
                }
              ]
            },
            {
              "method": "GET",
              "path": "/me/enrollments",
              "purpose": "查询预置当前学生的已选教学班列表",
              "response": {
                "status": 200,
                "fields": [
                  "enrollment_id",
                  "offering_id",
                  "course_name"
                ]
              },
              "request_context": {
                "student_id": "预置的当前学生标识"
              }
            }
          ]
        }
      }
    },
    {
      "key": "DM-ENROLL",
      "kind": "DataModel",
      "name": "选课数据模型设计",
      "description": "待实现的选课数据模型，新增教学班容量与已选人数，并定义非负、人数不超容量及事务一致性约束。",
      "status": "draft",
      "attributes": {
        "schema_definition": {
          "purpose": "待实现的数据结构设计，尚未创建业务数据库表",
          "tables": {
            "Student": {
              "fields": {
                "student_id": "字符串，主键，教学示例预置身份"
              }
            },
            "Course": {
              "fields": {
                "course_id": "字符串，主键",
                "name": "课程名称"
              }
            },
            "Offering": {
              "fields": {
                "offering_id": "字符串，主键",
                "course_id": "关联 Course.course_id",
                "teacher": "授课教师名称",
                "capacity": "非负整数，零表示不接受新的选课",
                "enrolled_count": "非负整数，有效选课记录数，初始为零"
              },
              "constraints": [
                {
                  "type": "check",
                  "expression": "capacity >= 0 and enrolled_count >= 0 and enrolled_count <= capacity"
                },
                {
                  "type": "transaction_consistency",
                  "expression": "enrolled_count 等于该教学班有效 Enrollment 记录数，容量检查、插入及人数更新原子提交"
                }
              ]
            },
            "Enrollment": {
              "fields": {
                "enrollment_id": "字符串，主键",
                "student_id": "关联 Student.student_id",
                "offering_id": "关联 Offering.offering_id"
              },
              "constraints": [
                {
                  "type": "unique",
                  "fields": [
                    "student_id",
                    "offering_id"
                  ],
                  "purpose": "同一学生在同一教学班最多保留一条选课记录"
                }
              ]
            }
          }
        },
        "extensions": {
          "implementation_status": "planned"
        }
      }
    },
    {
      "key": "CODE-ENROLL",
      "kind": "CodeArtifact",
      "name": "选课服务待实现代码",
      "description": "计划实现包含容量限制的选课服务代码；需保留幂等行为并使用事务内并发保护，当前没有源码或测试执行证据。",
      "status": "draft",
      "attributes": {
        "path": "src/enrollment_service.py",
        "symbol": "enroll",
        "language": "python",
        "extensions": {
          "implementation_status": "planned",
          "planned_responsibilities": [
            "查询教学班目录",
            "按预置学生查询已选列表",
            "首次选课创建记录",
            "重复请求返回原记录并保持唯一约束",
            "在事务内检查教学班容量并拒绝零容量或满员的新选课",
            "为最后名额提供并发安全的原子写入",
            "重复请求不重复消耗容量，失败时完整回滚"
          ]
        }
      }
    },
    {
      "key": "TEST-ENROLL",
      "kind": "TestCase",
      "name": "基础选课与幂等验收定义",
      "description": "待实现、待执行的验收用例定义，不代表测试已经运行或通过。",
      "status": "draft",
      "attributes": {
        "steps": [
          "预置学生 S001、S002 以及教学班 O101、O102。",
          "查询教学班目录，检查可以看到 O101、O102 及课程名称、教师。",
          "S001 首次选择 O101，查询 S001 已选列表。",
          "S001 再次选择 O101，比较两次返回的选课记录标识和记录数量。",
          "查询 S002 已选列表，检查不会出现 S001 的选课记录。"
        ],
        "expected_result": "目录内容正确；S001 首次选课成功，重复请求返回同一记录且总记录数为一；S002 的已选列表保持独立。",
        "extensions": {
          "execution_status": "not_run"
        }
      }
    },
    {
      "key": "REQ-CAPACITY",
      "kind": "Requirement",
      "name": "教学班容量限制",
      "description": "新增选课必须遵守教学班容量，容量为零或已满时拒绝新的选课；并发请求不能导致超额，已有选课的重复请求仍按基础需求返回原记录。",
      "status": "draft",
      "attributes": {
        "requirement_type": "functional",
        "acceptance_criteria": [
          "capacity 为非负整数；capacity=0 的教学班拒绝任何新的选课，记录与人数保持不变。",
          "capacity=1 时，第一名学生选课成功；第二名学生的新选课被拒绝，最终有效选课人数为一。",
          "剩余一个名额时两名不同学生并发选课，至多一人成功，事务提交后选课人数不超过容量。",
          "已选学生重复请求同一教学班时，返回原记录，不再消耗名额；即使教学班已满也保持该幂等结果。",
          "容量校验、选课记录写入及人数变化必须处于同一事务；拒绝或失败时不留下部分写入。"
        ]
      }
    },
    {
      "key": "BR-CAPACITY",
      "kind": "BusinessRule",
      "name": "教学班新增选课不得超过容量",
      "description": "教学班容量是非负整数；仅在尚有名额时接受新的选课。容量校验与写入应在事务内串行化或使用等效的原子条件，不能用先查人数后无保护写入实现。",
      "status": "draft",
      "attributes": {
        "expression": {
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "new_enrollment_condition": "enrolled_count < capacity",
          "capacity_zero": "reject_new_enrollment",
          "duplicate_request": "return_existing_before_capacity_check",
          "atomicity": "check_and_write_in_one_transaction"
        }
      }
    },
    {
      "key": "TEST-CAPACITY",
      "kind": "TestCase",
      "name": "零容量、满员与并发限额验收定义",
      "description": "待实现、待执行的容量与并发验收用例，不代表已经完成业务测试。",
      "status": "draft",
      "attributes": {
        "steps": [
          "预置容量为零的教学班 O201，学生 S001 尝试首次选课。",
          "预置容量为一的教学班 O202，S001 首次选课，再由 S002 选课。",
          "让已选 O202 的 S001 重复请求，检查仍返回原选课记录且人数不增加。",
          "预置只剩一个名额的教学班 O203，同步启动 S001、S002 两个不同学生的选课请求。",
          "在两个请求结束后统计成功数、有效选课记录和 enrolled_count，并检查拒绝请求未留下部分写入。"
        ],
        "expected_result": "零容量拒绝新选课；满员拒绝新增；重复请求保持幂等；并发至多一人占用最后名额，记录与人数一致且不超容量。",
        "extensions": {
          "execution_status": "not_run"
        }
      }
    }
  ],
