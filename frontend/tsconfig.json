{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "isolatedModules": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
